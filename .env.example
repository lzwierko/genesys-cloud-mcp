GENESYSCLOUD_REGION=mypurecloud.de
GENESYSCLOUD_OAUTHCLIENT_ID=your-oauth-client-id
GENESYSCLOUD_OAUTHCLIENT_SECRET=your-oauth-client-secret
# Leave the secret empty for browser login. Register this exact callback on the OAuth client.
GENESYSCLOUD_REDIRECT_URI=http://localhost:6798/
GENESYSCLOUD_PERSIST_TOKENS=false
MCP_TRANSPORT=stdio
MCP_TOOL_ACCESS=all
MCP_HOST=127.0.0.1
MCP_PORT=7568
