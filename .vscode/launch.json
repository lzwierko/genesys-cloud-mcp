{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug MCP HTTP",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/index.ts",
      "runtimeArgs": ["--env-file=${workspaceFolder}/.env"],
      "args": ["--transport=http"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
